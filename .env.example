APP_NAME=Hostorio
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://hostorio.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database Configuration
DB_CONNECTION=sqlite
# Or use MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hostorio
# DB_USERNAME=root
# DB_PASSWORD=

# Session & Caching
SESSION_DRIVER=database
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# Mail Configuration (optional)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@hostorio.com
MAIL_FROM_NAME=Hostorio

# Settings
SETTINGS_CACHE_TTL=3600
